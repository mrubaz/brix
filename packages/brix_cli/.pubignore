# Only the template's own code is published; `flutter create` makes the
# platform folders for each new app.
templates/*/android/
templates/*/ios/
templates/*/web/
templates/*/build/
templates/*/.dart_tool/
templates/*/.idea/
templates/*/.metadata
templates/*/.flutter-plugins-dependencies
templates/*/pubspec.lock
templates/*/pubspec_overrides.yaml
build/
templates/*/tool/
